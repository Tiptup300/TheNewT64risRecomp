+// Debug virtual-input overlay. WSLg/Wayland forbids external synthetic key injection
+// (see the input diagnosis), so for headless automation the game reads a control file
+// named by the TNT_INPUT env var: whitespace/newline-separated SDL scancodes that are
+// currently "held". While TNT_INPUT is set the injected file is the SOLE key source —
+// the real keyboard is IGNORED — so automated tests get exclusive control and a stray
+// physical keypress (or window focus) can't leak in and corrupt a run. Inert (zero
+// overhead beyond one getenv) when TNT_INPUT is unset. Level-triggered: write scancodes
+// to hold keys, empty the file to release.
+static const char* g_tnt_input_path = nullptr;
+static bool g_tnt_input_checked = false;
+static std::vector<Uint8> g_tnt_merged;
+
 void recompinput::poll_inputs() {
-    InputState.keys = SDL_GetKeyboardState(&InputState.numkeys);
+    const Uint8* real_keys = SDL_GetKeyboardState(&InputState.numkeys);
+    if (!g_tnt_input_checked) {
+        g_tnt_input_path = std::getenv("TNT_INPUT");
+        g_tnt_input_checked = true;
+    }
+    if (g_tnt_input_path != nullptr && InputState.numkeys > 0) {
+        // Exclusive control: start from all-keys-up (ignore the real keyboard) so only
+        // the injected scancodes are seen. This prevents stray physical input from
+        // breaking automated tests.
+        (void)real_keys;
+        g_tnt_merged.assign((size_t)InputState.numkeys, (Uint8)0);
+        if (FILE* f = std::fopen(g_tnt_input_path, "r")) {
+            int sc;
+            while (std::fscanf(f, "%d", &sc) == 1) {
+                if (sc >= 0 && sc < InputState.numkeys) g_tnt_merged[sc] = 1;
+            }
+            std::fclose(f);
+        }
+        InputState.keys = g_tnt_merged.data();
+    } else {
+        InputState.keys = real_keys;
+    }
     InputState.keymod = SDL_GetModState();
     static bool first_poll = true;
 
