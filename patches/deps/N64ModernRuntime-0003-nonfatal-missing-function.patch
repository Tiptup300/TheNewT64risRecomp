+// --- Indirect-call tracer (a naming aid for the symbol campaign). Inert unless the
+// TNT_INDIRECT_TRACE env var names an output file. Every indirect call routes through
+// get_function(), so this captures the DYNAMIC caller->target edges that a static call
+// graph cannot see (jump-table / function-pointer reached functions). The caller is
+// recovered from the native return address via dladdr (recompiled functions are real
+// exported symbols). Unique edges are appended immediately so the log survives the
+// segfault-on-close exit. See tools/tracemap.py.
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <set>
+namespace {
+    struct TntIndirectTracer {
+        bool on = false;
+        const char* out = nullptr;
+        std::set<int32_t> seen;   // one representative native call stack per target
+        TntIndirectTracer() {
+            if (const char* e = getenv("TNT_INDIRECT_TRACE")) {
+                on = true; out = e;
+                if (FILE* f = fopen(out, "w")) fclose(f); // truncate at start
+            }
+        }
+        void record(int32_t addr) {
+            if (!on) return;
+            if (!seen.insert(addr).second) return;   // first stack per target is enough
+            // Walk the native stack and log each frame's symbol so tracemap.py can pick
+            // the nearest NAMED game-function ancestor (the immediate caller is often
+            // itself a placeholder dispatcher). Frame 0 is record() itself; skip it.
+            void* bt[24];
+            int n = backtrace(bt, 24);
+            FILE* f = fopen(out, "a");
+            if (!f) return;
+            fprintf(f, "0x%08X", (uint32_t)addr);
+            for (int i = 2; i < n; ++i) {   // 2 = skip record() + get_function()
+                Dl_info info;
+                if (dladdr(bt[i], &info) && info.dli_sname) fprintf(f, "\t%s", info.dli_sname);
+            }
+            fprintf(f, "\n");
+            fclose(f);
+        }
+    };
+    TntIndirectTracer g_tnt_indirect_tracer;
+}
+
 extern "C" recomp_func_t * get_function(int32_t addr) {
+    g_tnt_indirect_tracer.record(addr);
     auto func_find = func_map.find(addr);
     if (func_find == func_map.end()) {
-        fprintf(stderr, "Failed to find function at 0x%08X\n", addr);
-        assert(false);
-        std::exit(EXIT_FAILURE);
+        // Some libultra debug/monitor functions (e.g. rmonPrintf) are in N64Recomp's
+        // reimplemented_funcs set and get omitted from the function table, so an
+        // INDIRECT call to one lands here. Aborting the whole game crashed players
+        // (e.g. an audio-error path indirect-calling rmonPrintf on the gameplay
+        // screen). Instead, log the missing address once and return a no-op so the
+        // game keeps running. Direct calls still resolve to their *_recomp stubs.
+        static std::unordered_set<int32_t> warned;
+        if (warned.insert(addr).second) {
+            fprintf(stderr, "Failed to find function at 0x%08X (returning no-op)\n", addr);
+        }
+        static recomp_func_t* const noop = +[](uint8_t*, recomp_context*) { };
+        return noop;
     }
     return func_find->second;
 }
