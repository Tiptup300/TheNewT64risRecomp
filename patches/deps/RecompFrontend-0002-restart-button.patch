+#include <cstdlib>
+#if defined(__linux__)
+#include <unistd.h>
+#endif
+
+// Restart the application back to the launcher. Used by the in-game "Restart"
+// button so the player can reconfigure mods (which only toggle before a game is
+// started) and boot again — the runtime has no in-place return-to-launcher.
+// We re-exec the same binary with TNT_NO_AUTOBOOT set so it stops at the
+// launcher instead of auto-booting straight back into the game.
+static void tnt_restart_to_launcher() {
+#if defined(__linux__)
+    setenv("TNT_NO_AUTOBOOT", "1", 1);
+    execl("/proc/self/exe", "/proc/self/exe", (char *)nullptr);
+    // If exec somehow fails, fall through to a plain quit.
+#endif
+    ultramodern::quit();
+}
